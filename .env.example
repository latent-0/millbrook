# Copy to .env and fill in. Do not commit .env.

# Google Apps Script web app URL that appends form submissions to a Sheet and
# emails office@rothenhall.com. See docs/forms-setup.md.
FORMS_WEBHOOK_URL=

# ── Blog publishing API (docs/blog-api.md) ──────────────────────────────────
# Bearer token every write/read of the blog API requires. Generate a long
# random secret, e.g. `openssl rand -hex 32`. If unset, every request returns
# 500 ServerMisconfigured (the API fails closed, never open).
BLOG_API_TOKEN=dev-local-token-change-me

# Redis REST store so posts persist across serverless invocations. Set both to
# use Vercel KV or Upstash Redis. When unset, the API falls back to a local
# .data/blog-kv.json file — fine for `npm run dev`, not for production.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Upstash's own variable names also work as an alternative to the KV_ pair:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional. Base URL used to build canonicalUrl and publishedUrl.
# Defaults to https://www.rothenhall.com when unset.
SITE_URL=
